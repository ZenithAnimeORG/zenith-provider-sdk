{
  "name": "zenith-provider-sdk-root",
  "version": "0.1.0",
  "private": true,
  "description": "Zenith Media Player Provider SDK & Documentation",
  "type": "module",
  "scripts": {
    "docs:generate": "typedoc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "npm run docs:generate && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "npm --prefix sdk-ts test",
    "build": "npm --prefix sdk-ts run build",
    "typecheck": "npm --prefix sdk-ts run typecheck"
  },
  "devDependencies": {
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.4.0",
    "vitepress": "^1.6.0"
  }
}
